# Remote nix builder for this checkout. Copy to `.remote-builder` (gitignored)
# and fill in your box. scripts/remote-builder.sh reads this and emits the
# exact nix flags, so nothing here is ever hardcoded in a script or an agent.

# ssh target for the builder (user@hostname).
HOST=nixremote@ec2-13-36-177-254.eu-west-3.compute.amazonaws.com

# Your ssh key for HOST. Read as *you* by nix-fast-build / nix copy (client-side
# remote store). ~ is expanded.
KEY=~/.ssh/nixremote_ed25519

# Builder system, job slots, and features: only needed for the `--builders`
# spec (daemon-scheduled `nix build --builders ... --max-jobs 0`).
SYSTEM=x86_64-linux
MAXJOBS=32
FEATURES=big-parallel,benchmark

# Key path the nix-daemon (root) uses for the `--builders` spec. The daemon
# runs as root, so it needs a root-readable path, not your ~/.ssh copy.
# Defaults to KEY if unset.
DAEMON_KEY=/root/.ssh/nixremote_ed25519

# Builder's ssh host public key, base64-encoded (`ssh-keyscan -t ed25519 HOST |
# base64 -w0`). Pins the host in the `--builders` spec; `-` (unset) skips it.
HOSTKEY=c3NoLWVkMjU1MTkgQUFBQUMzTnphQzFsWkRJMU5URTVBQUFBSVBaVVdoYXBOUEZjSGYxL3l3UEg5WTBzY2lGTENWTWE5ZElmYlZPUDZ6aUUgcm9vdEBpcC0xMC0yNDAtMTg2LTg4Cg==
