+static const unsigned char *map_tzfile(const char *pathname, size_t *size)
+{
+	int fd = open(pathname, O_RDONLY|O_CLOEXEC);
+	if (fd < 0) return 0;
+
+	struct stat st;
+	if (fstat(fd, &st) < 0 || st.st_size <= 0 || (uint64_t)st.st_size > SIZE_MAX) {
+		close(fd);
+		return 0;
+	}
+
+	size_t len = st.st_size;
+	unsigned char *data = malloc(len);
+	if (!data) {
+		close(fd);
+		return 0;
+	}
+
+	size_t pos = 0;
+	while (pos < len) {
+		ssize_t n = read(fd, data + pos, len - pos);
+		if (n > 0) {
+			pos += n;
+			continue;
+		}
+		if (n < 0 && errno == EINTR) continue;
+		free(data);
+		close(fd);
+		return 0;
+	}
+
+	close(fd);
+	*size = len;
+	return data;
