Prefer src.tag over src.rev when deciding whether a version moved.

fetchFromGitHub derives rev = "refs/tags/${tag}" from a `tag` argument, so a
package pinned by tag evaluates with both set. Reading rev first meant the
fetched candidate ("v1.2.3") never matched the package's rev
("refs/tags/v1.2.3"), so find_prefixed_version reported a change on every run
and nix-update re-prefetched src and every dependency hash even when the
version was unchanged. diff_urls.py already prefers tag.

--- a/nix_update/update.py
+++ b/nix_update/update.py
@@ -22,7 +22,7 @@
     if package.new_version is None:
         msg = "Package new_version is None, cannot replace version"
         raise ValueError(msg)
-    old_rev_tag = package.rev or package.tag
+    old_rev_tag = package.tag or package.rev
     old_version = package.old_version
     new_version = package.new_version.number
     new_version = new_version.removeprefix("v")
@@ -79,7 +79,7 @@
 
     version_prefix = ""
     branch = None
-    old_rev_tag = package.rev or package.tag
+    old_rev_tag = package.tag or package.rev
 
     if preference != VersionPreference.BRANCH:
         if old_rev_tag and old_rev_tag.endswith(package.old_version):
